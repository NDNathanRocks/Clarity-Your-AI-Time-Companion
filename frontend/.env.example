# API Configuration Template
# Copy this file to .env and update with your laptop's IP address

# For local development (web browser)
EXPO_PUBLIC_API_URL_WEB=http://localhost:8000/api

# For mobile devices (iPhone, Android) - CHANGE THIS TO YOUR LAPTOP'S IP
# To find your IP:
#   Windows: Run 'ipconfig' in Command Prompt (look for IPv4 Address)
#   Mac/Linux: Run 'ifconfig' or 'ip addr' in Terminal
EXPO_PUBLIC_API_URL_MOBILE=http://YOUR_LAPTOP_IP:8000/api
